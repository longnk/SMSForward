{
  "id": "longnk.SMSForward.sub",
  "name": "SMSForward-cus 的应用订阅",
  "author": "longnk",
  "icon": "https://raw.githubusercontent.com/longnk/SMSForward/custom/asset/1.png",
  "repo": "https://github.com/longnk/SMSForward",
  "apps": [
    {
      "id": "longnk.sms_forward_custom",
      "name": "短信转发(自用)",
      "descs_html": [
        "<a href=\"https://github.com/longnk/SMSForward\">查看文档</a>",
        "<a onClick=\"window.location.reload(true);\">刷新</a>"
      ],
      "keys": [
        "@longnk.sms_forward_custom.disabled",
        "@longnk.sms_forward_custom.type",
        "@longnk.sms_forward_custom.sender_allow",
        "@longnk.sms_forward_custom.sender_deny",
        "@longnk.sms_forward_custom.text_allow",
        "@longnk.sms_forward_custom.text_deny",
        "@longnk.sms_forward_custom.code_test",
        "@longnk.sms_forward_custom.code_get",
        "@longnk.sms_forward_custom.replace_num",
        "@longnk.sms_forward_custom.no_post",
        "@longnk.sms_forward_custom.title",
        "@longnk.sms_forward_custom.subtitle",
        "@longnk.sms_forward_custom.body",
        "@longnk.sms_forward_custom.pushdeer",
        "@longnk.sms_forward_custom.bark",
        "@longnk.sms_forward_custom.post_json_url",
        "@longnk.sms_forward_custom.post_json_data",
        "@longnk.sms_forward_custom.keys"
      ],
      "author": "longnk",
      "repo": "https://github.com/longnk/SMSForward",
      "settings": [
        {
          "id": "@longnk.sms_forward_custom.disabled",
          "name": "禁用",
          "val": false,
          "type": "boolean",
          "desc": "默认启用"
        },
        {
          "id": "@longnk.sms_forward_custom.type",
          "name": "类型",
          "val": "tencent",
          "type": "selects",
          "items": [
            {
              "key": "tencent",
              "label": "腾讯手机管家"
            },
            {
              "key": "360",
              "label": "360 手机卫士"
            }
          ],
          "desc": "默认使用 腾讯手机管家"
        },
        {
          "id": "@longnk.sms_forward_custom.sender_allow",
          "name": "允许转发的号码的正则字符串",
          "val": "",
          "type": "textarea",
          "desc": "符合的号码才会转发 例: (18600000000|18611111111) 表示只转发这两个号码. ^186 表示只转发186开头的号码. ^\\d{11}$ 表示只转发11位的号码. 默认为空 允许转发所有号码"
        },
        {
          "id": "@longnk.sms_forward_custom.sender_deny",
          "name": "不允许转发的号码的正则字符串",
          "val": "",
          "type": "textarea",
          "desc": "符合的号码不会转发 其他的号码都会转发"
        },
        {
          "id": "@longnk.sms_forward_custom.text_allow",
          "name": "允许转发的内容的正则字符串",
          "val": "",
          "type": "textarea",
          "desc": "符合的内容才会转发 例: (码|快递) 表示只允许这包含这俩词的内容. 默认为空 允许转发所有内容"
        },
        {
          "id": "@longnk.sms_forward_custom.text_deny",
          "name": "不允许转发的内容的正则字符串",
          "val": "",
          "type": "textarea",
          "desc": "符合的内容不会转发 其他的内容都会转发"
        },
        {
          "id": "@longnk.sms_forward_custom.code_test",
          "name": "判断内容是否包含验证码的正则字符串",
          "val": "",
          "type": "textarea",
          "desc": "验证码提取逻辑没有很好的思路 现在需要先判断该内容是否有验证码 再提取验证码. 默认为 .+(码) 表示内容符合 'X码' 这样的格式"
        },
        {
          "id": "@longnk.sms_forward_custom.code_get",
          "name": "从内容提取验证码的正则字符串",
          "val": "",
          "type": "textarea",
          "desc": "提取的验证码将作为可复制的内容 方便 Bark 复制. 默认为 \\d{4,6} 表示提取4-6位的数字"
        },
        {
          "id": "@longnk.sms_forward_custom.no_post",
          "name": "不提交数据给腾讯/360等接口",
          "val": false,
          "type": "boolean",
          "desc": "默认为否, 会正常提交. 若开启, 则不会提交任何数据给腾讯/360等接口 保证隐私"
        },
        {
          "id": "@longnk.sms_forward_custom.replace_num",
          "name": "替换数字",
          "val": true,
          "type": "boolean",
          "desc": "默认启用. 将提交给腾讯/360等接口的内容中的数字替换为随机数字 防止泄漏"
        },
        {
          "id": "@longnk.sms_forward_custom.title",
          "name": "通知标题模板",
          "val": "",
          "type": "text",
          "desc": "默认: [号码], 例: 10010"
        },
        {
          "id": "@longnk.sms_forward_custom.subtitle",
          "name": "通知副标题模板",
          "val": "",
          "type": "text",
          "desc": "默认: [码][复制提示], 例: 123456(长按/下拉复制验证码)"
        },
        {
          "id": "@longnk.sms_forward_custom.body",
          "name": "通知正文模板",
          "val": "",
          "type": "textarea",
          "desc": "默认: [内容], 例: 您的验证码为 123456"
        },
        {
          "id": "@longnk.sms_forward_custom.bark",
          "name": "转发到 Bark/自建服务端 等",
          "val": "",
          "type": "textarea",
          "desc": "[推送标题], [推送内容], [复制内容] 会被自动替换. 形如 https://api.day.app/XXXXXXXXX/[推送标题]/[推送内容]?group=sms&autoCopy=1&isArchive=1&icon=https%3A%2F%2Fraw.githubusercontent.com%2Flongnk%2Fscripts%2Fcustom%2Fsurge%2Fmodules%2Fsms-forward%2Fasset%2F1.png&copy=[复制内容]&sound=shake&level=timeSensitive"
        },
        {
          "id": "@longnk.sms_forward_custom.pushdeer",
          "name": "转发到 PushDeer/PushPlus 等",
          "val": "",
          "type": "textarea",
          "desc": "[推送全文] 会被自动替换. 形如 https://api2.pushdeer.com/message/push?pushkey=XXXXXXXXXXX&text=[推送全文]"
        },
        {
          "id": "@longnk.sms_forward_custom.post_json_url",
          "name": "转发到 自定义JSON接口 URL",
          "val": "",
          "type": "text",
          "desc": "[号码] [内容] [验证码] 会被自动替换. 形如 https://xxx.com/message/push?text=[内容]"
        },
        {
          "id": "@longnk.sms_forward_custom.post_json_data",
          "name": "转发到 自定义JSON接口 数据",
          "val": "{\n  \"dev\": \"XX\",\n  \"sender\": \"[号码]\",\n  \"msg\": \"[内容]\",\n  \"code\": \"[验证码]\"\n}",
          "type": "textarea",
          "desc": "[号码] [内容] [验证码] 会被自动替换. 形如 {\n  \"from\": \"[号码]\",\n  \"content\": \"[内容]\",\n  \"code\": \"[验证码]\"\n}"
        },
        {
          "id": "@longnk.sms_forward_custom.keys",
          "name": "其他配置的 key(英文逗号,分隔)",
          "val": "",
          "type": "textarea",
          "desc": "默认只取 sms_forward_custom 的配置. 设置为 sms_forward_custom-1, sms_forward_custom-2 后, 将同时处理这三个配置"
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/longnk/SMSForward/custom/asset/1.png",
        "https://raw.githubusercontent.com/longnk/SMSForward/custom/asset/1.png"
      ]
    }
  ]
}